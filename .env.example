# Postgres connection string (Dokploy: copy the "Internal Connection URL" of your Postgres service)
DATABASE_URL=postgres://sofia:sofia@localhost:5434/sofia

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public URL of the site, used for OAuth callbacks in production
# AUTH_URL=https://sofiaamin.com

# Comma-separated Google accounts allowed into /admin
ADMIN_EMAILS=you@example.com

# Local only: enables a "Dev login" button that signs in as this email without Google.
# Ignored in production builds.
DEV_LOGIN_EMAIL=you@example.com
